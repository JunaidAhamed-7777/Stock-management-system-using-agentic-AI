# Database connection
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/stock_management"

# JWT secret
JWT_SECRET="replace-with-a-long-random-secret"

# Bcrypt salt rounds
BCRYPT_SALT_ROUNDS="10"

# Server port
PORT="3001"

# Frontend URL for CORS
CLIENT_URL="http://localhost:5173"

# Optional: N8N integration variables
#N8N_BASE_URL=""
#N8N_API_KEY=""
#N8N_FORECAST_WEBHOOK=""
#N8N_STOCKOUT_WEBHOOK=""
#N8N_RECOMMENDATION_WEBHOOK=""
