# Server Environment Variables
# Copy this file to .env and fill in your local development values.
# DO NOT commit real credentials or push .env to version control.

# Database
DATABASE_URL=postgresql://YOUR_POSTGRES_USER:YOUR_POSTGRES_PASSWORD@localhost:5432/stock_management?schema=public

# Authentication
JWT_SECRET=change-this-to-a-secure-random-string
BCRYPT_SALT_ROUNDS=10

# Server
PORT=3001

# n8n Integration (for future AI agent connectivity)
# These are placeholder values - set when connecting to n8n instance
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=

# Frontend URL (for CORS configuration)
FRONTEND_URL=http://localhost:5173
